rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
             data.id == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 254 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048));
    }

    function isValidDownloadItem(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'platform', 'title', 'originalUrl', 'timestamp', 'createdAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             (data.platform in ['instagram', 'tiktok', 'youtube']) &&
             data.title is string && data.title.size() <= 500 &&
             data.originalUrl is string && data.originalUrl.size() <= 2048 &&
             data.timestamp is number &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('author' in data) || (data.author is string && data.author.size() <= 150)) &&
             (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 2048));
    }

    // User profile matching
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User downloads history subcollection
      match /downloads/{downloadId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(downloadId) && isValidDownloadItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(downloadId) && isValidDownloadItem(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(downloadId);
      }
    }
  }
}
